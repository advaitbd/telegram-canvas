{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "telegram-canvas",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "routes": [
    { "pattern": "canvas.advaitdeshpande.com/*", "zone_name": "advaitdeshpande.com" }
  ],
  "d1_databases": [
    {
      "binding": "CANVAS_DB",
      "database_name": "telegram-canvas",
      "database_id": "fa7685ec-cea5-49fb-ae03-a6f932a78234"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CANVAS_ARTIFACTS",
      "bucket_name": "telegram-canvas-artifacts"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTIFACT_ROOM",
        "class_name": "ArtifactRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArtifactRoom"]
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
